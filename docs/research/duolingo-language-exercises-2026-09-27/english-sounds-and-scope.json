  "items": [
    {
      "id": "EI01",
      "name": "英语音素目录与点听",
      "classification": "navigation_reference",
      "source_ids": [
        "ES01"
      ],
      "asset_ids": [
        "EA01",
        "EA02"
      ],
      "action": "点音素格听声音，进入按专家顺序编排的成对语音练习。",
      "boundary": "目录及入口，不能计为独立答题题型。",
      "target_language": "en",
      "live_app_tested": false
    },
    {
      "id": "EI02",
      "name": "听音辨别近音词",
      "classification": "english_sounds_variant_of_audio_choice",
      "source_ids": [
        "ES01"
      ],
      "asset_ids": [
        "EA03"
      ],
      "action": "听声音，在两个英语近音词中选择并检查。",
      "target_language": "en",
      "live_app_tested": false
    },
    {
      "id": "EI03",
      "name": "同词或异词判断",
      "classification": "english_sounds_binary_discrimination",
      "source_ids": [
        "ES01"
      ],
      "asset_ids": [
        "EA04"
      ],
      "action": "播放两段音频，判断它们是同一个词还是不同词。",
      "target_language": "en",
      "live_app_tested": false
    },
    {
      "id": "EI04",
      "name": "语音与英语词配对",
      "classification": "english_sounds_variant_of_matching",
      "source_ids": [
        "ES01",
        "ES02"
      ],
      "asset_ids": [
        "EA05",
        "EA06"
      ],
      "action": "试听音频，逐一配对英语词形。",
      "boundary": "完整截图采用韩语界面，但目标语言始终是英语。",
      "target_language": "en",
      "live_app_tested": false
    },
    {
      "id": "EI05",
      "name": "五卡口述词汇回忆",
      "classification": "new_flashcard_active_recall_loop",
      "source_ids": [
        "ES03"
      ],
      "asset_ids": [
        "EA07",
        "EA08"
      ],
      "action": "看到母语提示，口述英语译词；正确卡变绿移走，错误卡翻面播答案并回到牌堆，至少答对三张通关。",
      "boundary": "直接证实葡语→英语；没有全平台、全部母语课程或订阅矩阵。总结图是反馈状态，不另外计题型。",
      "target_language": "en",
      "live_app_tested": false
    },
    {
      "id": "EI06",
      "name": "词汇卡打字替代",
      "classification": "input_alternative_not_separate_question_type",
      "source_ids": [
        "ES03"
      ],
      "asset_ids": [],
      "action": "不便开口时可以输入英语答案。",
      "boundary": "官方文字确认；未取得该替代状态的完整英语 UI。",
      "target_language": "en",
      "live_app_tested": false
    },
    {
      "id": "EI07",
      "name": "英语完整句跟读录音",
      "classification": "existing_speaking_type_with_direct_english_evidence",
      "source_ids": [
        "ES05"
      ],
      "asset_ids": [
        "EA09"
      ],
      "action": "听或读英语整句，点击麦克风跟读。",
      "boundary": "普通句子口语练习，不能称为逐音素评分；图片只显示录音前界面。",
      "target_language": "en",
      "live_app_tested": false
    },
    {
      "id": "EI08",
      "name": "英语解释英语：定义选择",
      "classification": "advanced_english_semantic_variant_of_choice",
      "source_ids": [
        "ES04"
      ],
      "asset_ids": [
        "EA10"
      ],
      "action": "借语境理解被突出显示的英语词，选择英语释义。",
      "target_language": "en",
      "live_app_tested": false
    },
    {
      "id": "EI09",
      "name": "英语场景对话续答",
      "classification": "advanced_english_pragmatic_variant_of_dialogue_choice",
      "source_ids": [
        "ES04"
      ],
      "asset_ids": [
        "EA11"
      ],
      "action": "理解英语问句并选择合乎情境的英语回复。",
      "target_language": "en",
      "live_app_tested": false
    },
    {
      "id": "EI10",
      "name": "英语图文语境填空",
      "classification": "advanced_english_contextual_variant_of_word_bank",
      "source_ids": [
        "ES04"
      ],
      "asset_ids": [
        "EA12"
      ],
      "action": "用英语词块补全文段；需要时点词查看母语提示。",
      "boundary": "弹层是辅助功能，不另计为题型；无翻译主任务不等于禁止母语提示。",
      "target_language": "en",
      "live_app_tested": false
    }
  ],
