# Keep captured test output verbatim; source and documentation still use normal whitespace checks.
docs/butcher-version/evidence/**/*.log -whitespace
# Preserve captured failure contexts and frozen source snapshots verbatim.
docs/butcher-version/evidence/**/*context.md -whitespace
docs/butcher-version/evidence/**/*.tap -whitespace
docs/butcher-version/evidence/**/*failure*.txt -whitespace
docs/butcher-version/evidence/**/*before*.js -whitespace
docs/butcher-version/evidence/**/*.pdf binary
tests/fixtures/**/*.js whitespace=-blank-at-eof
# This fixture has a SHA-256 provenance manifest; keep archived Git bytes exact.
tests/fixtures/classroom-before-fivezones/** -text -whitespace
tests/fixtures/course-loader-before-update-choice/course-loader.js -text
tests/fixtures/course-worker-before-archive/** -text -whitespace
server/legacy/*.js whitespace=-blank-at-eof
unit*/history.js whitespace=-blank-at-eof
# CSV audit exports use CRLF line endings; retain the other whitespace checks.
docs/butcher-version/evidence/**/*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Imported research sources and captured browser logs retain their original bytes.
docs/research/duolingo-language-exercises-2026-09-27/sources/*.html -whitespace
docs/research/duolingo-language-exercises-2026-09-27/sources/*.log -whitespace
docs/research/duolingo-language-exercises-2026-09-27/**/*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Reviewed journey provenance is byte-addressed; do not rewrite its line endings.
docs/designs/course-journey/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/designs/course-journey/production/** -whitespace
docs/designs/course-journey/provenance/** -whitespace
docs/designs/course-journey/generated/** -whitespace
docs/designs/course-journey/prompts/** -whitespace
docs/designs/course-journey/recipes/** -whitespace
docs/designs/course-journey/evidence/** -whitespace
docs/designs/course-journey/evidence/**/*.zip binary
assets/course-journey/** -text
# The approved prototype verifies protected runtime bytes across Windows and CI.
poc/keepsake-postoffice/** text=auto eol=lf
