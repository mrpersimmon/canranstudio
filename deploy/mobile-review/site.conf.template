# A separate host. Do not replace or edit the official site's server block.
server {
    listen 80;
    server_name preview.canranstudio.cn;
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/canran-mobile-acme; }
    location / { return 301 https://preview.canranstudio.cn$request_uri; }
}
server {
    listen 443 ssl;
    server_name preview.canranstudio.cn;
    server_tokens off;
    if ($host != preview.canranstudio.cn) { return 444; }
    ssl_certificate __TLS_CERTIFICATE__;
    ssl_certificate_key __TLS_KEY__;
    client_max_body_size 1500k;
    add_header X-Robots-Tag "noindex, nofollow" always;
    location / {
        proxy_pass http://127.0.0.1:4404;
        proxy_http_version 1.1;
        proxy_set_header Host preview.canranstudio.cn;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_cache off;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
