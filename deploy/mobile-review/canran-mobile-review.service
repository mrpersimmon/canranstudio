[Unit]
Description=Canran isolated mobile acceptance
After=network.target
[Service]
Type=simple
User=canran-mobile-review
Group=canran-mobile-review
WorkingDirectory=/opt/canran-mobile-review/current
Environment=NODE_ENV=production
Environment=LESSON_PORT=4404
Environment=LESSON_BASE_PATH=/
Environment=LESSON_ORIGIN=https://preview.canranstudio.cn
Environment=LESSON_TRUST_PROXY=loopback
Environment=LESSON_DATA_DIR=/var/lib/canran-mobile-review
Environment=LESSON_VIEWPORT_METRICS_ENABLED=0
ExecStart=/opt/canran-node/bin/node server/run.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/canran-mobile-review
CPUQuota=50%
MemoryMax=768M
UMask=0077
[Install]
WantedBy=multi-user.target
