[Unit]
Description=Canran private review bench
After=network.target

[Service]
Type=simple
User=canran-preview
Group=canran-preview
WorkingDirectory=/opt/canran-preview/current
Environment=NODE_ENV=production
Environment=PREVIEW_PORT=4403
Environment=PREVIEW_CONFIG_FILE=/etc/canran-preview/config.json
ExecStart=/opt/canran-node/bin/node scripts/private-preview.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=512M
CPUQuota=50%
UMask=0077

[Install]
WantedBy=multi-user.target
