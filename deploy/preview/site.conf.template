# Install as a separate virtual host. Never replace the www.canranstudio.cn configuration.
server {
    listen 80;
    server_name __PREVIEW_HOST__;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/canran-preview/acme; }
    location / { return 301 https://__PREVIEW_HOST__$request_uri; }
}
server {
    listen 443 ssl;
    server_name __PREVIEW_HOST__;
    ssl_certificate __TLS_CERTIFICATE__;
    ssl_certificate_key __TLS_KEY__;
    client_max_body_size 4k;
    location / {
        proxy_pass http://127.0.0.1:4403;
        proxy_http_version 1.1;
        proxy_set_header Host __PREVIEW_HOST__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
        proxy_set_header Connection "";
        proxy_cache off;
        proxy_read_timeout 60s;
    }
}
